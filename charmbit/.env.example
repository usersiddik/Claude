# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Google sign-in (required to copy or export). Leave empty to keep copying open.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random characters, e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# Optional: canonical site URL for metadata, OG, robots, and sitemap.
# NEXT_PUBLIC_SITE_URL=https://example.com
