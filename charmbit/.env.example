# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Turns on the AI sticker maker. Without it, the maker answers in quick mode (keyword matching).
ANTHROPIC_API_KEY=

# Optional: the Claude model for the AI maker (default: claude-opus-5-5).
# CHARMBIT_AI_MODEL=claude-haiku-5-5

# Optional: canonical site URL for metadata, OG, robots, and sitemap.
# NEXT_PUBLIC_SITE_URL=https://example.com
